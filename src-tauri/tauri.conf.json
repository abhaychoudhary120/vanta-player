{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VANTA",
  "version": "1.1.0",
  "identifier": "com.vanta.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VANTA",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "preventOverflow": {
          "width": 32,
          "height": 32
        },
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#07070b",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A premium, next-gen local media player.",
    "longDescription": "VANTA is a premium local media player for Windows with a cinematic glass interface, instant seeking, rich playlist controls, immersive spatial audio, and silky-smooth MP4 and MP3 playback.",
    "category": "Video",
    "copyright": "Copyright © 2026 VANTA",
    "fileAssociations": [
      {
        "ext": ["mp3", "m4a", "aac", "wav", "flac", "ogg", "oga", "opus"],
        "name": "VANTA Audio",
        "description": "Audio file",
        "role": "Viewer",
        "mimeType": "audio/*"
      },
      {
        "ext": ["mp4", "m4v", "webm", "mov", "mkv", "avi"],
        "name": "VANTA Video",
        "description": "Video file",
        "role": "Viewer",
        "mimeType": "video/*"
      },
      {
        "ext": ["png", "jpg", "jpeg", "webp", "gif", "svg"],
        "name": "VANTA Image",
        "description": "Image file",
        "role": "Viewer",
        "mimeType": "image/*"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QTE5M0IyNjEyNDRENDQKUldSRVRTUmhzcE9oOS9HMkw5Q21xQ3VCNi9pMlZVQUlGTUhLSzFNS3I4VWVvM0R4TDJkZ3M2bE8K",
      "endpoints": [
        "https://github.com/abhaychoudhary120/vanta-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
